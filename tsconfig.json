{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@config": ["src/config.ts"],
      "@interfaces/*": ["src/interface/*"],
      "@utils/*": ["src/utils/*"]
    },
    "strict": true, // 或 "target": "ES6"
    "esModuleInterop": true
  }
}
