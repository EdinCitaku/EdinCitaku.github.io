---
import { SOCIAL } from "@/config";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <a class="wordmark" href="/">Edin <em>Citaku</em></a>
    <nav class="footer-links label" aria-label="Elsewhere">
      {
        SOCIAL.map((item) => (
          <a href={item.href} {...(item.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
            {item.text}
          </a>
        ))
      }
    </nav>
    <div class="footer-fine label">
      <span>&copy; {year} Edin Citaku</span>
      <button class="theme-toggle label" type="button" data-theme-toggle aria-label="Switch colour theme">
        <span class="to-dark">Dark mode</span>
        <span class="to-light">Light mode</span>
      </button>
    </div>
  </div>
</footer>
