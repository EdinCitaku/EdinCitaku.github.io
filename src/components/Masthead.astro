---
import { NAV } from "@/config";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<header class="masthead">
  <div class="wrap masthead-inner">
    <nav class="label" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.text}
          </a>
        ))
      }
    </nav>
    <a class="wordmark" href="/" aria-label="Edin Citaku — home">Edin <em>Citaku</em></a>
    <div class="masthead-tools label">
      <a href="/rss.xml">RSS</a>
      <button class="theme-toggle label" type="button" data-theme-toggle aria-label="Switch colour theme">
        <span class="to-dark">Dark</span>
        <span class="to-light">Light</span>
      </button>
    </div>
  </div>
</header>
