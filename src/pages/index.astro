---
import { Image } from "astro:assets";
import PostRow from "@/components/PostRow.astro";
import Base from "@/layouts/Base.astro";
import { formatDate, getPosts, postNumber } from "@/utils/posts";

const posts = await getPosts();
const [lead, ...rest] = posts;
const recent = rest.slice(0, 5);
---

<Base>
  <div class="wrap">
    <section class="hero">
      <p class="label rise">Essays on startups, careers &amp; software</p>
      <h1 class="hero-text rise rise-2">
        I&rsquo;m Edin Citaku, founder of
        <a href="https://veltha.ai" target="_blank" rel="noopener noreferrer">Veltha</a>, where we&rsquo;re building
        the Co-Adjuster for workers&rsquo; comp. <em>Here I write about the things that hold my interest.</em>
      </h1>
    </section>

    {
      lead && (
        <section aria-labelledby="latest">
          <div class="section-head label">
            <h2 class="label" id="latest">
              The latest
            </h2>
            <span>No. {postNumber(posts, lead)}</span>
          </div>
          <article class="lead">
            {
              lead.data.cover && (
                <a class="lead-art" href={`/blog/${lead.slug}/`} tabindex="-1" aria-hidden="true">
                  <Image
                    src={lead.data.cover}
                    alt=""
                    widths={[640, 960, 1280, 1612]}
                    sizes="(max-width: 56rem) 100vw, 40rem"
                    loading="eager"
                  />
                </a>
              )
            }
            <div>
              <div class="lead-meta label">
                <time datetime={lead.data.pubDate.toISOString()}>{formatDate(lead.data.pubDate)}</time>
                {lead.data.tags?.[0] && <span class="accent">{lead.data.tags[0]}</span>}
              </div>
              <h3 class="lead-title">
                <a href={`/blog/${lead.slug}/`}>{lead.data.title}</a>
              </h3>
              <p class="lead-dek">{lead.data.description}</p>
              <a class="more label" href={`/blog/${lead.slug}/`}>
                Read the essay <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        </section>
      )
    }

    <section aria-labelledby="earlier">
      <div class="section-head label">
        <h2 class="label" id="earlier">Earlier</h2>
        <a href="/blog">All writing &rarr;</a>
      </div>
      <ol class="rows">
        {recent.map((post) => <PostRow post={post} number={postNumber(posts, post)} />)}
      </ol>
    </section>
  </div>
</Base>
