---
import { SITE, SOCIAL } from "@/config";
import Base from "@/layouts/Base.astro";

const links = SOCIAL.filter((item) => item.text !== "RSS");
const display = (href: string) =>
  href.replace(/^mailto:|^https?:\/\/(www\.)?/g, "").replace(/\/$/, "");
---

<Base title="About" description="About Edin Citaku, founder of Veltha.">
  <div class="wrap">
    <header class="page-head">
      <p class="label rise">About</p>
      <h1 class="page-title rise rise-2">Edin <em>Citaku</em></h1>
    </header>

    <section class="about">
      <figure class="portrait">
        <img src="/profile.png" alt="Portrait of Edin Citaku" width="800" height="800" />
        <figcaption class="label">San Francisco</figcaption>
      </figure>

      <div class="about-body">
        <p class="lede">
          I&rsquo;m the founder of <a href="https://veltha.ai" target="_blank" rel="noopener noreferrer">Veltha</a>,
          where we&rsquo;re building the Co-Adjuster for workers&rsquo; comp.
        </p>
        <p>
          I&rsquo;m based in San Francisco. On this site I write about the things that interest me &mdash; lately
          that means building a startup, and before that, careers in tech and the occasional piece of software.
        </p>
        <p>
          The best way to reach me is by <a href={`mailto:${SITE.email}`}>email</a>. You can also follow new essays
          through the <a href="/rss.xml">RSS feed</a>.
        </p>

        <ul class="contact">
          {
            links.map((item) => (
              <li>
                <span class="label">{item.text}</span>
                <a href={item.href} {...(item.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                  {display(item.href)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>
