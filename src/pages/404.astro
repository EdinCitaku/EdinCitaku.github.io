---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Error 404</p>
      <h1 class="page-title">Nothing <em>here.</em></h1>
      <p class="page-intro">The page you were looking for has moved, or never existed.</p>
      <a class="more label" href="/blog">Browse all writing <span aria-hidden="true">&rarr;</span></a>
    </header>
  </div>
</Base>
