---
import PostRow from "@/components/PostRow.astro";
import Base from "@/layouts/Base.astro";
import { getPosts, type Post } from "@/utils/posts";

const posts = await getPosts();

const years = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}

const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort();
---

<Base title="Writing" description="Every essay by Edin Citaku, newest first.">
  <div class="wrap">
    <header class="page-head">
      <p class="label rise">{posts.length} essays &middot; {Math.min(...years.keys())}&ndash;{Math.max(...years.keys())}</p>
      <h1 class="page-title rise rise-2">Writing</h1>
      <nav class="topics label rise rise-3" aria-label="Topics">
        <a href="/blog" aria-current="page">All</a>
        {tags.map((tag) => <a href={`/blog/tag/${tag}/`}>{tag}</a>)}
      </nav>
    </header>

    {
      [...years.entries()].map(([year, yearPosts]) => (
        <section class="year" aria-label={String(year)}>
          <h2 class="year-num">{year}</h2>
          <ol class="rows">
            {yearPosts.map((post) => (
              <PostRow post={post} shortDate />
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Base>
