---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { formatDate, getPosts, type Post, postNumber } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      number: postNumber(posts, post),
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}

interface Props {
  post: Post;
  number: string;
  newer?: Post;
  older?: Post;
}

const { post, number, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await post.render();
const {
  title,
  description,
  pubDate,
  updated,
  tags,
  cover,
  coverAlt,
  coverCredit,
} = post.data;
---

<Base title={title} description={description} image={`/og/${post.slug}.png`} type="article">
  <article class="wrap">
    <header class="article-head">
      <p class="label rise">
        <span>No. {number}</span>
        {tags?.map((tag) => <a class="accent" href={`/blog/tag/${tag}/`}>{tag}</a>)}
      </p>
      <h1 class="article-title rise rise-2">{title}</h1>
      <p class="article-dek rise rise-3">{description}</p>
      <p class="byline label">
        <span>By Edin Citaku</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updated && <span>Updated {formatDate(updated)}</span>}
        <span>{remarkPluginFrontmatter.readingTime} min read</span>
      </p>
    </header>

    {
      cover && (
        <figure class="article-cover">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[640, 960, 1280, 1612]}
            sizes="(max-width: 62rem) 100vw, 56rem"
            loading="eager"
          />
          {coverCredit && <figcaption class="label">{coverCredit}</figcaption>}
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <p class="endmark" aria-hidden="true">&#10086;</p>

    <nav class="pager" aria-label="More essays">
      {
        older ? (
          <a href={`/blog/${older.slug}/`}>
            <span class="label">&larr; Previous</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        ) : (
          <a href="/blog">
            <span class="label">&larr; Index</span>
            <span class="pager-title">All writing</span>
          </a>
        )
      }
      {
        newer ? (
          <a href={`/blog/${newer.slug}/`}>
            <span class="label">Next &rarr;</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        ) : (
          <a href="/blog">
            <span class="label">Index &rarr;</span>
            <span class="pager-title">All writing</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
